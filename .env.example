# Copy to `.env.local` (git-ignored) for local development.
#
# Development-only auth bypass: seeds a mock session so you can click through
# every screen without signing in. It is ignored when NODE_ENV === 'production',
# so it can never take effect in a production build.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# Which mock user to test as: "vendor" (dashboard) or "customer".
NEXT_PUBLIC_DEV_USER_ROLE=customer

# Optional: point the server-side proxy at a different backend.
# Server-only (not exposed to the browser). Defaults to https://api.shopam.net
# BACKEND_API_URL=https://api.shopam.net
